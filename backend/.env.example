# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ride_admin_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
# Generate a strong secret key using: require('crypto').randomBytes(64).toString('hex')
JWT_SECRET=replace_this_with_a_strong_random_secret_key
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Email Configuration (using Gmail SMTP as an example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=no-reply@rideadmin.com

# GeoLocation API Key (for IP-based country detection)
# Register at https://ipapi.co/ for a free API key
GEOLOCATION_API_KEY=your_geolocation_api_key

# Restricted Countries (comma-separated ISO codes)
RESTRICTED_COUNTRIES=SY,AF,IR,KP,CU

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info